{
  "name": "my-star-wars-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint \"src/**/*.{js,jsx}\"",
    "lint:fix": "eslint \"src/**/*.{js,jsx}\" --fix",
    "format:check": "prettier --check \"src/**/*.{js,jsx,json,css}\" \"*.js\" \"*.mjs\" \"*.json\"",
    "format:write": "prettier --write \"src/**/*.{js,jsx,json,css}\" \"*.js\" \"*.mjs\" \"*.json\"",
    "quality:hygiene": "node scripts/quality/hygiene.mjs",
    "quality:lint-baseline": "node scripts/quality/lint-baseline.mjs",
    "quality:format-baseline": "node scripts/quality/format-baseline.mjs",
    "quality": "npm run quality:hygiene && npm run quality:lint-baseline && npm run quality:format-baseline && npm run build && git diff --exit-code",
    "test:b2:runtime": "node scripts/b2/runtime-contract.mjs",
    "test:b3:swapi": "node --test test/swapi.test.mjs",
    "test:b3:runtime": "node scripts/b3/runtime-contract.mjs",
    "test:b4:data": "node --test test/b4-data.test.mjs",
    "test:b4:runtime": "node scripts/b4/runtime-contract.mjs",
    "test:b5:semantics": "node --test test/b5-semantics.test.mjs",
    "test:b5:runtime": "node scripts/b5/runtime-contract.mjs"
  },
  "dependencies": {
    "i18next": "^23.16.8",
    "next": "15.5.25",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^14.1.3",
    "tailwind-scrollbar": "^3.1.0"
  },
  "devDependencies": {
    "autoprefixer": "^10.6.1",
    "eslint": "^8.57.1",
    "eslint-config-next": "15.5.25",
    "postcss": "^8.5.28",
    "prettier": "3.9.8",
    "tailwindcss": "^3.4.19"
  },
  "engines": {
    "node": ">=24.20.0 <25",
    "npm": ">=11.19.0 <12"
  },
  "packageManager": "npm@11.19.0"
}
